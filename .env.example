# Copy only on the production server. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_50_CHARACTERS
ALLOWED_HOSTS=your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example
POSTGRES_DB=prolegacy
POSTGRES_USER=prolegacy
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
SECURE_HSTS_SECONDS=0
TRUST_PROXY_SSL_HEADER=False
PRODUCTION_LOCAL_PORT=8089
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Pro Legacy Corp <no-reply@roofingprolegacycorp.com>
LOG_LEVEL=INFO
